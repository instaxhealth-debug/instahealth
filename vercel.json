{
  "buildCommand": "npx prisma generate && npm run build",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "regions": ["dub1"],
  "crons": [
    {
      "path": "/api/admin/sla/enforce",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/shopify-sync",
      "schedule": "0 2 * * *"
    }
  ],
  "functions": {
    "app/**": {
      "maxDuration": 10
    },
    "app/api/**": {
      "maxDuration": 30
    }
  }
}
