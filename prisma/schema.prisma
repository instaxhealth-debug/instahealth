// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String?    // Nullable for future OAuth support
  name              String?
  image             String?    // NextAuth required
  emailVerified     DateTime?  // NextAuth required
  role              Role       @default(USER)
  defaultLocationId String?    // User's default location preference
  defaultLocation   Location?  @relation(fields: [defaultLocationId], references: [id], onDelete: SetNull)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  
  // Relations
  orders            Order[]
  carts             Cart[]
  accounts          Account[]
  sessions          Session[]
  addresses         Address[]
}

enum Role {
  ADMIN
  USER
}

enum VendorOrderStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  REJECTED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  CANCELLED_BY_VENDOR
  FAILED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ActorType {
  SYSTEM
  USER
  VENDOR
  ADMIN
}

// NextAuth adapter models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label             String   // e.g. "Home", "Work"
  formattedAddress  String
  placeId           String
  lat               Float
  lng               Float
  city              String?
  state             String?
  country           String?
  postalCode        String?
  normalizedHash    String   // For deduplication
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, normalizedHash])
  @@index([userId])
}

model Vendor {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  email     String?     @unique
  userId    String?     @unique  // Link to User for auth (vendor portal access)
  status    String      @default("active")
  verified  Boolean     @default(false)  // Replaces complianceAccepted for search
  legalEntityName String?
  country   String?
  licenseNumber String?
  complianceAccepted Boolean @default(false)
  complianceAcceptedAt DateTime?
  logoUrl   String?
  tagline   String?
  rating    Float?
  ratingCount Int?
  isHouseBrand Boolean @default(false)
  
  // Geo fields for service radius enforcement
  basePlaceId           String?
  baseAddressFormatted  String?
  baseLat               Float?
  baseLng               Float?
  serviceRadiusKm       Int     @default(25)
  enforceServiceRadius  Boolean @default(true)
  allowOutOfRadiusOverride Boolean @default(false)
  
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  products  Product[]
  orderItems OrderItem[]
  vendorOrders VendorOrder[]
  vendorPayouts VendorPayout[]

  @@index([slug])
  @@index([userId])
}

model Product {
  id          String          @id @default(cuid())
  vendorId    String
  vendor      Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name        String
  slug        String          @unique
  description String?
  category    String
  priceFils   Int
  imageUrl    String?
  inStock     Boolean         @default(true)
  inventoryStatus String      @default("in_stock")  // in_stock, low, out
  active      Boolean         @default(true)
  published   Boolean         @default(true)  // Separate from active for editorial control
  isGlobal    Boolean         @default(false) // If true, available in all locations regardless of ProductLocation rows
  tags        String[]        @default([])    // Search tags
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  locations   ProductLocation[]
  orderItems  OrderItem[]
  variants    ProductVariant[]
  cartItems   CartItem[]

  @@index([vendorId])
  @@index([isGlobal])
}

model ProductVariant {
  id          String      @id @default(cuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String      @unique
  strength    String
  unitSize    String?
  priceFils   Int
  inStock     Boolean     @default(true)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  cartItems   CartItem[]

  @@index([productId])
}

model Location {
  id        String          @id @default(cuid())
  name      String          @unique
  slug      String          @unique
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  
  // Relations
  products      ProductLocation[]
  users         User[]           // Users with this as default location
  carts         Cart[]           // Carts at this location

  @@index([isActive])
}

model ProductLocation {
  productId String
  locationId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location  Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([productId, locationId])
}

model Order {
  id                       String      @id @default(cuid())
  userId                   String?
  user                     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  locationId               String?
  status                   String      @default("PENDING_PAYMENT") // PENDING_PAYMENT, PAID, FULFILLING, FULFILLED, PARTIALLY_FULFILLED, CANCELLED, REFUNDED
  subtotalFils             Int
  deliveryFils             Int         @default(0)
  totalFils                Int
  currency                 String      @default("AED")
  stripeCheckoutSessionId  String?     @unique
  stripePaymentIntentId    String?
  acceptedTerms            Boolean     @default(false)
  acceptedDisclaimer       Boolean     @default(false)
  ageConfirmed             Boolean     @default(false)
  shippingName             String?
  shippingPhone            String?
  shippingAddressLine1     String?
  shippingAddressLine2     String?
  shippingNotes            String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  items                    OrderItem[]
  vendorOrders             VendorOrder[]
  events                   OrderEvent[]
  refunds                  Refund[]

  @@index([userId])
  @@index([stripeCheckoutSessionId])
  @@index([status])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  vendorId      String
  variantId     String?
  quantity      Int     @default(1)
  unitPriceFils Int
  lineTotalFils Int
  // Snapshot fields - preserve order data even if product changes
  productName   String  // Snapshot of product.name at time of order
  productSlug   String? // Snapshot of product.slug
  vendorName    String  // Snapshot of vendor.name at time of order
  variantSku    String?
  variantStrength String?
  variantUnitSize String?
  variantPriceFils Int?
  fulfilled     Boolean @default(false)
  fulfilledAt   DateTime?
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  vendor        Vendor  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  vendorOrderItems VendorOrderItem[]

  @@index([orderId])
  @@index([productId])
  @@index([vendorId])
  @@index([vendorId, fulfilled])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    // Nullable for guest carts (though guests use localStorage)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String?   // Selected location for this cart
  location  Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  status    String     @default("ACTIVE") // ACTIVE, ORDERED
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@unique([userId]) // Only one active cart per user
  @@index([userId])
  @@index([status])
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  productId     String
  variantId     String?
  quantity      Int      @default(1)
  unitPriceFils Int      @default(0) // Price in fils (1 AED = 100 fils)
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
}

model VendorPayout {
  id         String   @id @default(cuid())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  amountFils Int
  status     String   @default("PENDING") // PENDING, PAID
  reference  String?
  paidAt     DateTime?
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([vendorId])
  @@index([status])
}

model VendorOrder {
  id              String            @id @default(cuid())
  orderId         String
  vendorId        String

  status          VendorOrderStatus @default(PENDING_ACCEPTANCE)
  acceptBy        DateTime
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  fulfilledAt     DateTime?
  cancelledAt     DateTime?

  notesToVendor   String?
  notesInternal   String?
  
  terminalReason   String?          // Why did this vendor order reach terminal state (SLA expiry, cancellation, etc)
  resolutionNotes  String?          // Additional context about resolution (optional)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor          Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items           VendorOrderItem[]
  events          OrderEvent[]
  refund          Refund?

  @@unique([orderId, vendorId])
  @@index([vendorId])
  @@index([status])
  @@index([acceptBy])
}

model Refund {
  id             String        @id @default(cuid())
  orderId        String
  vendorOrderId  String        @unique
  stripeRefundId String?
  amountFils     Int
  reason         String
  status         RefundStatus  @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorOrder    VendorOrder   @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model VendorOrderItem {
  id            String        @id @default(cuid())
  vendorOrderId String
  orderItemId   String

  vendorOrder   VendorOrder   @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([vendorOrderId, orderItemId])
  @@index([vendorOrderId])
  @@index([orderItemId])
}

model OrderEvent {
  id            String    @id @default(cuid())
  orderId       String?
  vendorOrderId String?

  actorType     ActorType
  actorId       String?
  eventType     String    // VENDOR_ORDER_CREATED, VENDOR_ACCEPTED, VENDOR_REJECTED, VENDOR_SLA_EXPIRED, etc.
  data          Json?

  createdAt     DateTime  @default(now())

  order         Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorOrder   VendorOrder? @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([vendorOrderId])
  @@index([eventType])
  @@index([createdAt])
}
