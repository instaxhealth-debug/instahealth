generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                        String           @id @default(cuid())
  email                     String           @unique
  passwordHash              String?
  name                      String?
  image                     String?
  emailVerified             DateTime?
  role                      Role             @default(USER)
  defaultLocationId         String?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  countryCode               String?
  phone                     String?
  heightCm                  Int?
  marketingEmailOptIn       Boolean          @default(false)
  marketingPushOptIn        Boolean          @default(false)
  weightKg                  Int?
  consentShareBodyMetrics   Boolean          @default(false)
  stripeCustomerId          String?          @unique
  emailNotificationsEnabled Boolean          @default(true)
  language                  String           @default("en")
  marketingOptIn            Boolean          @default(false)
  smsNotificationsEnabled   Boolean          @default(false)
  timezone                  String           @default("Asia/Dubai")
  accounts                  Account[]
  addresses                 Address[]
  carts                     Cart?
  orders                    Order[]
  serviceBookings           ServiceBooking[]
  bookings                  Booking[]
  sessions                  Session[]
  defaultLocation           Location?        @relation(fields: [defaultLocationId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id               String           @id @default(cuid())
  userId           String
  label            String
  formattedAddress String
  placeId          String
  lat              Float
  lng              Float
  city             String?
  country          String           @default("United Arab Emirates")
  postalCode       String?
  normalizedHash   String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  area             String?
  emirate          String?
  instructions     String?
  isDefault        Boolean          @default(false)
  line1            String
  line2            String?
  phone            String?
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders           Order[]
  serviceBookings  ServiceBooking[]

  @@unique([userId, normalizedHash])
  @@index([userId])
  @@index([userId, isDefault])
}

model Vendor {
  id                       String             @id @default(cuid())
  name                     String
  slug                     String             @unique
  email                    String?            @unique
  status                   String             @default("active")
  legalEntityName          String?
  country                  String?
  licenseNumber            String?
  complianceAccepted       Boolean            @default(false)
  complianceAcceptedAt     DateTime?
  logoUrl                  String?
  tagline                  String?
  rating                   Float?
  ratingCount              Int?
  isHouseBrand             Boolean            @default(false)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  verified                 Boolean            @default(false)
  allowOutOfRadiusOverride Boolean            @default(false)
  baseAddressFormatted     String?
  baseLat                  Float?
  baseLng                  Float?
  basePlaceId              String?
  enforceServiceRadius     Boolean            @default(true)
  serviceRadiusKm          Int                @default(25)
  userId                   String?            @unique
  allowedCategories        String[]
  phone                    String?
  phoneRaw                 String?
  bookingUrl               String?
  bookingInstructions      String?
  shopifyAccessToken       String?
  shopifyConnected         Boolean            @default(false)
  shopifyInstalledAt       DateTime?
  shopifyLastSyncAt        DateTime?
  shopifyScopes            String?
  shopifyShopDomain        String?
  shopifyStorefrontToken   String?
  shopifySyncStatus        String?
  // MARKETPLACE: Vendor Availability System
  workingDays              Int[]              @default([1, 2, 3, 4, 5, 6, 0]) // 0=Sun, 1=Mon, etc
  workingHoursStart        String?            @default("09:00") // HH:mm format
  workingHoursEnd          String?            @default("18:00")
  slotDurationMinutes      Int?               @default(60)
  bufferTimeMinutes        Int?               @default(15)
  cartItems                CartItem[]
  orderItems               OrderItem[]
  products                 Product[]
  serviceBookings          ServiceBooking[]
  bookings                 Booking[]
  approvedApplications     VendorApplication?
  vendorOrders             VendorOrder[]
  vendorPayouts            VendorPayout[]

  @@index([slug])
  @@index([userId])
  @@index([shopifyConnected])
  @@index([shopifyShopDomain])
}

model Product {
  id                  String            @id @default(cuid())
  vendorId            String
  name                String
  slug                String            @unique
  description         String?
  category            String
  priceFils           Int
  imageUrl            String?
  inStock             Boolean           @default(true)
  active              Boolean           @default(true)
  isGlobal            Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  inventoryStatus     String            @default("in_stock")
  published           Boolean           @default(true)
  tags                String[]          @default([])
  sku                 String?
  importKey           String?
  featured            Boolean           @default(false)
  bookingUrl          String?
  durationMinutes     Int?
  serviceType         String            @default("physical-product")
  requiresBooking     Boolean           @default(false)
  checkoutMode        String?
  externalCheckoutUrl String?
  externalHandle      String?
  externalId          String?
  externalVariantId   String?
  isPublished         Boolean           @default(true)
  lastExternalSyncAt  DateTime?
  source              String            @default("native")
  syncStatus          String?
  deletedAt           DateTime?
  cartItems           CartItem[]
  orderItems          OrderItem[]
  vendor              Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  locations           ProductLocation[]
  variants            ProductVariant[]
  serviceBookings     ServiceBooking[]
  bookings            Booking[]

  @@unique([vendorId, sku])
  @@unique([vendorId, importKey])
  @@unique([vendorId, externalVariantId], name: "vendorId_externalVariantId", map: "vendorId_externalVariantId")
  @@unique([vendorId, externalId], map: "vendorId_externalId")
  @@index([vendorId])
  @@index([isGlobal])
  @@index([featured])
  @@index([featured, createdAt])
  @@index([serviceType])
  @@index([requiresBooking])
  @@index([externalId])
  @@index([source])
  @@index([source, syncStatus])
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  sku        String      @unique
  strength   String
  unitSize   String?
  priceFils  Int
  inStock    Boolean     @default(true)
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  cartItems  CartItem[]
  orderItems OrderItem[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model MarketplaceEvent {
  id        String               @id @default(cuid())
  productId String
  vendorId  String
  eventType MarketplaceEventType
  createdAt DateTime             @default(now())

  @@index([createdAt])
}

model Location {
  id        String            @id @default(cuid())
  name      String            @unique
  slug      String            @unique
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  carts     Cart[]
  products  ProductLocation[]
  users     User[]

  @@index([isActive])
}

model ProductLocation {
  productId  String
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locationId])
}

model Order {
  id                      String        @id @default(cuid())
  userId                  String?
  locationId              String?
  status                  String        @default("PENDING_PAYMENT")
  subtotalFils            Int
  deliveryFils            Int           @default(0)
  totalFils               Int
  currency                String        @default("AED")
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?
  acceptedTerms           Boolean       @default(false)
  acceptedDisclaimer      Boolean       @default(false)
  ageConfirmed            Boolean       @default(false)
  shippingName            String?
  shippingPhone           String?
  shippingAddressLine1    String?
  shippingAddressLine2    String?
  shippingNotes           String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  addressId               String?
  shippingArea            String?
  shippingEmirate         String?
  address                 Address?      @relation(fields: [addressId], references: [id])
  user                    User?         @relation(fields: [userId], references: [id])
  events                  OrderEvent[]
  items                   OrderItem[]
  refunds                 Refund[]
  vendorOrders            VendorOrder[]

  @@index([userId])
  @@index([addressId])
  @@index([stripeCheckoutSessionId])
  @@index([status])
  @@index([status, createdAt])
}

model OrderItem {
  id               String            @id @default(cuid())
  orderId          String
  productId        String
  vendorId         String
  variantId        String?
  quantity         Int               @default(1)
  unitPriceFils    Int
  lineTotalFils    Int
  productName      String
  productSlug      String?
  vendorName       String
  variantSku       String?
  variantStrength  String?
  variantUnitSize  String?
  variantPriceFils Int?
  fulfilled        Boolean           @default(false)
  fulfilledAt      DateTime?
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id])
  variant          ProductVariant?   @relation(fields: [variantId], references: [id])
  vendor           Vendor            @relation(fields: [vendorId], references: [id])
  vendorOrderItems VendorOrderItem[]

  @@index([orderId])
  @@index([productId])
  @@index([vendorId])
  @@index([vendorId, fulfilled])
  @@index([productId, orderId])
}

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  locationId String?
  status     String     @default("ACTIVE")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  location   Location?  @relation(fields: [locationId], references: [id])
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@index([userId])
  @@index([status])
}

model CartItem {
  id            String          @id @default(cuid())
  cartId        String
  productId     String
  variantId     String?
  quantity      Int             @default(1)
  unitPriceFils Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  vendorId      String
  cart          Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  vendor        Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
  @@index([vendorId])
}

model VendorPayout {
  id          String    @id @default(cuid())
  vendorId    String
  amountFils  Int
  status      String    @default("PENDING")
  reference   String?
  paidAt      DateTime?
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([status])
}

model VendorOrder {
  id              String            @id @default(cuid())
  orderId         String
  vendorId        String
  status          VendorOrderStatus @default(NEW)
  acceptBy        DateTime
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  fulfilledAt     DateTime?
  cancelledAt     DateTime?
  notesToVendor   String?
  notesInternal   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  resolutionNotes String?
  terminalReason  String?
  subtotalFils    Int               @default(0)
  totalFils       Int               @default(0)
  events          OrderEvent[]
  refund          Refund?
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor          Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items           VendorOrderItem[]

  @@unique([orderId, vendorId])
  @@index([vendorId])
  @@index([status])
  @@index([acceptBy])
}

model Refund {
  id             String       @id @default(cuid())
  orderId        String
  vendorOrderId  String       @unique
  stripeRefundId String?
  amountFils     Int
  reason         String
  status         RefundStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorOrder    VendorOrder  @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model VendorOrderItem {
  id            String      @id @default(cuid())
  vendorOrderId String
  orderItemId   String
  orderItem     OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@unique([vendorOrderId, orderItemId])
  @@index([vendorOrderId])
  @@index([orderItemId])
}

model OrderEvent {
  id            String       @id @default(cuid())
  orderId       String?
  vendorOrderId String?
  actorType     ActorType
  actorId       String?
  eventType     String
  data          Json?
  createdAt     DateTime     @default(now())
  order         Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorOrder   VendorOrder? @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([vendorOrderId])
  @@index([eventType])
  @@index([createdAt])
}

model VendorApplication {
  id                         String                  @id @default(cuid())
  legalBusinessName          String
  tradingName                String?
  country                    String
  city                       String
  businessRegNumber          String
  taxVatNumber               String?
  website                    String?
  businessCategory           String
  businessDescription        String
  contactFullName            String
  contactRole                String
  contactEmail               String
  contactPhone               String
  contactWhatsApp            String?
  preferredContactMethod     String
  operationRegion            String
  fulfillmentType            String
  deliveryTimeframe          String
  hasProductImages           Boolean                 @default(false)
  complianceDocs             String[]                @default([])
  productDescription         String
  skuCount                   Int?
  hasPricing                 Boolean                 @default(false)
  informationAccuracy        Boolean                 @default(false)
  agreeContact               Boolean                 @default(false)
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  approvedAt                 DateTime?
  approvedBy                 String?
  notes                      String?
  ipAddress                  String?
  userAgent                  String?
  approvedVendorId           String?                 @unique
  confirmationEmailError     String?
  confirmationEmailMessageId String?
  confirmationEmailSentAt    DateTime?
  confirmationEmailStatus    ConfirmationEmailStatus @default(PENDING)
  status                     VendorApplicationStatus @default(PENDING)
  logoUrl                    String?
  selectedCategories         String[]                @default([])
  inviteEmailError           String?
  inviteEmailMessageId       String?
  inviteEmailSentAt          DateTime?
  inviteEmailStatus          ConfirmationEmailStatus @default(PENDING)
  contactPhoneRaw            String?
  approvedVendor             Vendor?                 @relation(fields: [approvedVendorId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([contactEmail])
}

model VendorInvite {
  id             String                  @id @default(cuid())
  email          String
  applicationId  String?
  vendorId       String?
  expiresAt      DateTime
  usedAt         DateTime?
  emailStatus    ConfirmationEmailStatus @default(PENDING)
  emailMessageId String?
  emailError     String?
  emailSentAt    DateTime?
  createdAt      DateTime                @default(now())
  tokenHash      String                  @unique

  @@index([email])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([applicationId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model ServiceBooking {
  id                      String               @id @default(cuid())
  userId                  String?
  customerName            String
  customerEmail           String
  customerPhone           String
  vendorId                String
  productId               String
  addressId               String
  amountFils              Int
  currency                String               @default("aed")
  stripeCheckoutSessionId String?              @unique
  stripePaymentIntentId   String?              @unique
  status                  ServiceBookingStatus @default(PAYMENT_PENDING)
  bookingUrlResolved      String?
  scheduledAt             DateTime?
  externalBookingRef      String?
  notes                   String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  address                 Address              @relation(fields: [addressId], references: [id])
  product                 Product              @relation(fields: [productId], references: [id])
  user                    User?                @relation(fields: [userId], references: [id])
  vendor                  Vendor               @relation(fields: [vendorId], references: [id])

  @@index([vendorId, createdAt])
  @@index([status, createdAt])
}

model Booking {
  id                      String        @id @default(cuid())
  userId                  String?
  vendorId                String
  productId               String
  variantId               String?
  status                  BookingStatus @default(PENDING_PAYMENT)
  customerName            String
  customerEmail           String
  customerPhone           String
  address                 String
  preferredDate           DateTime?
  preferredTimeWindow     String?
  notes                   String?
  // MARKETPLACE: Real Availability System (replaces soft preference)
  scheduledStart          DateTime?
  scheduledEnd            DateTime?
  scheduledAt             DateTime?     // Legacy field - keeping for backwards compatibility
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?       @unique
  amountFils              Int
  currency                String        @default("AED")
  // MARKETPLACE: Money Flow Tracking
  totalPriceFils          Int?          // Total customer paid (same as amountFils initially)
  platformFeeFils         Int?          // Platform commission
  vendorPayoutFils        Int?          // Amount vendor receives
  payoutStatus            PayoutStatus  @default(PENDING)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  user                    User?         @relation(fields: [userId], references: [id])
  vendor                  Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product                 Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vendorId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
  @@index([vendorId, status])
  @@index([userId, status])
  @@index([scheduledStart])
  @@index([vendorId, scheduledStart])
  @@index([payoutStatus])
}

model ShopifyOAuthState {
  nonce     String   @id
  vendorId  String?
  timestamp BigInt
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum Role {
  ADMIN
  USER
  VENDOR
}

enum VendorOrderStatus {
  NEW
  READY_FOR_FULFILLMENT
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
  FAILED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum MarketplaceEventType {
  VIEW
  ADD_TO_CART
  BOOK_CLICK
  PURCHASE
}

enum ActorType {
  SYSTEM
  USER
  VENDOR
  ADMIN
}

enum VendorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConfirmationEmailStatus {
  PENDING
  SENT
  FAILED
}

enum ServiceBookingStatus {
  PAYMENT_PENDING
  PAID_AWAITING_SCHEDULE
  SCHEDULED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum BookingStatus {
  PENDING_PAYMENT
  PENDING_VENDOR_CONFIRMATION
  CONFIRMED
  RESCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED
}
